# Public site URL used for canonical links, hreflang, sitemap and JSON-LD.
# Recommended domain from the brief. Change if a different domain is bought.
NEXT_PUBLIC_SITE_URL=https://elhoshydental.com

# Optional. Web3Forms access key. When set, the lead form also emails a copy of each lead.
# NEXT_PUBLIC_WEB3FORMS_KEY=

# Optional. Cloudflare Web Analytics beacon token. When set, the beacon script is added.
# NEXT_PUBLIC_CF_BEACON_TOKEN=
