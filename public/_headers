# Cloudflare static assets: cache lifetimes. HTML stays revalidated on every request (default).
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/models/*
  Cache-Control: public, max-age=604800
/draco/*
  Cache-Control: public, max-age=31536000, immutable
/basis/*
  Cache-Control: public, max-age=31536000, immutable
/posters/*
  Cache-Control: public, max-age=604800
/placeholders/*
  Cache-Control: public, max-age=604800
/brand/*
  Cache-Control: public, max-age=604800
